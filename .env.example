# ClussCloud 配置模板：复制为 .env 后按需填写
# 密钥类配置不入库（.gitignore 已忽略 .env）

# 服务端口（公共服务约定 10003）
PORT=10003

# JWT 密钥（网页端登录态签名），32 位以上随机串，必须设置
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# 平台运营者（部署这个公共服务的人）：首次启动自动建号，之后不改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 对外访问入口（注册页生成的 .env 模板里 CLUSS_RELAY_URL 用它；留空则按请求头推断）
PUBLIC_BASE_URL=

# 数据库路径（默认 ./database/clusscloud.db）
# DB_PATH=./database/clusscloud.db
